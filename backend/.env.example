# ===========================================================================
# Backend environment configuration.
#
# You only need to edit the ROOT `.env` file of the project (one level up).
# This file exists so the backend can also be configured standalone.
# If both files define the same variable, the value in this file wins.
# ===========================================================================

AI_PROVIDER=groq

GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=

GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-3-flash-preview

AI_TEMPERATURE=0.3
AI_MAX_TOKENS=1400
AI_REQUEST_TIMEOUT=60

MAX_MESSAGE_LENGTH=5000
MAX_HISTORY_MESSAGES=12

CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

LOG_LEVEL=INFO
